PORT=3000
NODE_ENV=development

ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (Railway에서 자동 주입)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── 플랫폼 통합 인증 ──────────────────────────────────────────────
# 모든 앱이 공유하는 JWT 서명 키. 프로덕션에서는 반드시 강한 값으로 교체.
JWT_SECRET=change-me-in-production

# 최초 부트스트랩: platform_accounts가 비어있으면 이 계정으로 admin 자동 생성.
# 로그인 후 반드시 비밀번호를 변경할 것.
PLATFORM_ADMIN_ID=admin
PLATFORM_ADMIN_PW=change-me-on-first-login

# mdBoard — Claude Code 등 programmatic 접근용 (플랫폼 로그인과 무관)
MDBOARD_API_KEY=your_api_key_here

# mdBoard 콘텐츠 저장 경로 — 기본값은 /data/contents/mdboard (Railway 볼륨 마운트 경로).
# 로컬 개발 환경엔 보통 /data가 없으므로(쓰기 권한 없음) 아래처럼 프로젝트 내 경로로 바꿔서 쓴다.
MDBOARD_CONTENTS_DIR=./projects/mdboard/.local-contents

# 버그/개선요청 신고(platform_feedback) 배치 처리 — Claude 배치가 x-api-key 헤더로
# GET/PUT /auth/feedback/batch/* 를 호출해 개선 리스트 조회·처리완료 반영할 때 필요
# FEEDBACK_API_KEY=your_api_key_here
# 위와 동일한 값을 GitHub 저장소 Actions secret으로도 등록해야
# .github/workflows/feedback-sync.yml / feedback-resolve.yml (GitHub Issue 브릿지)가 동작함
# → repo Settings → Secrets and variables → Actions → New repository secret → 이름 FEEDBACK_API_KEY

# travellog / totalprice — Claude API (여행지 추천, 종목 AI 참고 자료 생성 등)
# ANTHROPIC_API_KEY=sk-ant-발급받은_API_키

# travellog - Google Drive (사진 파일 저장)
GOOGLE_SERVICE_ACCOUNT=base64_encoded_service_account_json
DRIVE_FOLDER_ID=your_drive_folder_id

# mdboard - Google Drive 백업 (월 1회 배치, 사용 시만 설정)
# scripts/mdboard-drive-migrate.js(레거시 Drive 백업분 → 볼륨 1회 이관)와
# core/jobs/mdboard-drive-backup.js(볼륨 → Drive 월 1회 백업)가 사용
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# MDBOARD_FOLDER_ID=

# ── 플랫폼 공통 메일 발송 (shared/mailer.js, Brevo HTTP API) ──────────
# Railway 등 일부 호스팅은 아웃바운드 SMTP 포트(25/465/587/2525)를 막아두는 경우가 있어
# raw SMTP 대신 Brevo REST API(HTTPS 443)로 발송한다.
# 설정 안 하면 발송 시도 시 에러가 나고 platform_mail_log에 실패로 기록됨
# BREVO_API_KEY=xkeysib-발급받은_API_키 (Brevo 대시보드 → Settings → SMTP & API → API Keys)
# SMTP_FROM=noreply@example.com (Brevo Senders에 인증된 발신 주소)

# ── 플랫폼 공통 메신저 알림 (shared/notify/) ──────────────────────────
# 텔레그램/디스코드/디스코드 DM/ntfy/웹푸시로 다중 수신자(본인/가족/지인)에게 알림 발송.
# 채널별 연결 정보(chat_id, discord webhook URL, discord user id, ntfy topic)는 env가 아니라
# admin 콘솔 → 알림 탭에서 수신자별로 등록한다. 여기 환경변수는 발송 자격증명만.
# 텔레그램: @BotFather로 봇 생성 후 발급받은 토큰
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# 디스코드(webhook): 서버 채널별 webhook URL을 그대로 저장해서 쓰므로 전역 env 불필요
# 디스코드 DM(봇): https://discord.com/developers/applications 에서 애플리케이션 생성 →
#   Bot 탭에서 봇 추가 후 토큰 발급 → bot scope로 본인 전용 비공개 서버에 초대 →
#   알림 받을 사람도 그 서버에 초대(활동 불필요, "같은 서버에 있다"는 자격 조건 충족용) →
#   각자 개발자 모드로 확인한 Discord User ID를 admin 콘솔/내 알림 설정에 등록
# DISCORD_BOT_TOKEN=your-bot-token
# ntfy: 기본 공개 서버(https://ntfy.sh) 사용 시 env 불필요 (수신자별로 topic만 등록)
# 웹푸시: VAPID 키 (아래 명령으로 생성) — 아직 브라우저 구독 UI는 미구현이라 당장은 불필요
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
